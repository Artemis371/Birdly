# Copy to .env.local for local development. On Vercel, set these in
# Project -> Settings -> Environment Variables. Never commit real values.

# Supabase -> Project Settings -> Data API (or the "Connect" button): Project URL
SUPABASE_URL=https://your-project-ref.supabase.co
# Supabase -> Project Settings -> API Keys: Publishable key (sb_publishable_...)
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Supabase -> Project Settings -> API Keys: Secret key (sb_secret_...). SERVER ONLY.
SUPABASE_SECRET_KEY=sb_secret_...

# The code people type to sign up. Make it long-ish (e.g. three random words).
INVITE_CODE=robin-maple-lantern
# Comma-separated admin emails.
ADMIN_EMAILS=you@example.com
# Public URL of the app (used in password-reset links).
SITE_URL=https://your-app.vercel.app

# Daily cron auth (Production). Long random string.
CRON_SECRET=
# End-date reminder emails for Leahys markets (Resend, https://resend.com).
RESEND_API_KEY=re_...
# Where reminders go. Must be the email you signed up to Resend with unless
# you've verified a sending domain in Resend.
ADMIN_NOTIFY_EMAIL=you@example.com
# Optional. Defaults to "Birdly <onboarding@resend.dev>".
EMAIL_FROM=
